# Dev server environment — Ubuntu Server, LAN-only (port 3001, HTTPS)
# Copy to ~/MyPortfolioSite-dev/.env and fill in all values.
#
# IMPORTANT: Use different secrets from production.
#
# IMPORTANT: WebAuthn requires a DOMAIN NAME, not an IP address.
#   The WebAuthn spec rejects IP-address RP IDs — passkeys will fail with
#   "'rp.id' cannot be used with the current origin" if you use an IP.
#   Pick a hostname (e.g. dev.andykeys.me) and point it at the server's
#   LAN IP via either:
#     - a hosts-file entry on each machine you test from
#       (Windows: C:\Windows\System32\drivers\etc\hosts), or
#     - a split-horizon / LAN DNS A record.
#
# IMPORTANT: Generate the self-signed certificate before deploying:
#            bash scripts/setup/generate-dev-certs.sh $LAN_IP $WEBAUTHN_HOST

# Server LAN IP (find with: ip -4 addr show | grep inet)
# Used for container/port binding and IP-based health checks only.
LAN_IP=192.168.x.x

# Hostname used to access the dev site and as the WebAuthn RP ID.
# MUST be a domain name (not an IP). Must resolve to LAN_IP on test machines.
WEBAUTHN_HOST=dev.example.com

# Backend internal port (must not conflict with prod backend on 8080)
PORT=8081

# Database — separate from prod (portfolio_prod)
DB_NAME=portfolio_dev
DB_USER=postgres
DB_PASSWORD=change-me-strong-dev-password

# Auth — use a different secret from production
JWT_SECRET=change-me-dev-jwt-secret-min-32-chars
JWT_EXPIRY=7d

# WebAuthn — RP_ID, ORIGIN and FRONTEND_URL must all use WEBAUTHN_HOST.
# RP_ID is the hostname only (no port, no protocol).
# ORIGIN/FRONTEND_URL must be exactly https://<WEBAUTHN_HOST>:3001
WEBAUTHN_RP_ID=dev.example.com
WEBAUTHN_ORIGIN=https://dev.example.com:3001
FRONTEND_URL=https://dev.example.com:3001
WEBAUTHN_RP_NAME=AK Portfolio (Dev)

# Email (optional — can leave blank to disable contact form)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=
