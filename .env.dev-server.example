# Dev server environment — Ubuntu Server, LAN-only.
# Copy to ~/MyPortfolioSite-dev/.env and fill in all values.
#
# This template is kept structurally aligned with .env.example (prod) so the
# two files diff cleanly. Same keys in the same order; only values differ.
#
# IMPORTANT: Use different secrets from production.
# IMPORTANT: WebAuthn requires a domain name (not an IP). Pick a hostname
#            (e.g. dev.example.com) and resolve it to LAN_IP via /etc/hosts
#            on test machines or split-horizon LAN DNS.
# IMPORTANT: Generate self-signed certs before first deploy:
#            bash scripts/setup/generate-dev-certs.sh $LAN_IP $SITE_HOST

# ── Network / hosting ─────────────────────────────────────────────────────────
LAN_IP=192.168.x.x
DOMAIN=
SITE_HOST=dev.example.com

# ── Environment ──────────────────────────────────────────────────────────────
DEPLOY_ENV=dev

# ── Docker Compose ───────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=portfolio_dev
NGINX_SERVICE=nginx
BACKEND_SERVICE=backend
PORT=8081
NGINX_PORT=3001
NGINX_HTTP_HOST_PORT=127.0.0.1:8079
NGINX_CONF_TEMPLATE=./scripts/config/nginx-dev-server.conf.template
CERT_MOUNT_SRC=./scripts/config/certs
CERT_MOUNT_DST=/etc/nginx/certs

# Optional volume name overrides to preserve existing data on first deploy.
# Leave empty for fresh project-namespaced volumes (recommended for new installs).
# To keep existing dev data: POSTGRES_VOLUME_NAME=postgres_dev_data ; UPLOADS_VOLUME_NAME=uploads_dev_data
POSTGRES_VOLUME_NAME=
UPLOADS_VOLUME_NAME=

# ── Deploy ───────────────────────────────────────────────────────────────────
CERT_MODE=self-signed
ROLLBACK_BRANCH=dev
BACKUP_DIR=~/backups/dev       # ~/... is expanded to $HOME by deploy-lib.sh; absolute paths also work

# ── Database ─────────────────────────────────────────────────────────────────
DB_NAME=portfolio_dev
DB_USER=postgres
DB_PASSWORD=change-me-strong-dev-password

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-dev-jwt-secret-min-32-chars
JWT_EXPIRY=1h
# Internal service account key — used by regression tests to bypass contact
# rate limiting. Generate with: openssl rand -hex 32
# See: docs/SECURITY.md, issue #406
SERVICE_KEY=change-me-dev-service-key-min-32-chars
# Service account JWT secret — used by automated services (deploy webhooks, scripts).
# Separate from JWT_SECRET so service credentials and admin credentials are non-interchangeable.
# Generate with: openssl rand -hex 32 (must be different from JWT_SECRET)
# See: scripts/ops/generate-service-token.js
SERVICE_JWT_SECRET=change-me-dev-service-jwt-secret-min-32-chars

# ── WebAuthn ─────────────────────────────────────────────────────────────────
WEBAUTHN_RP_ID=dev.example.com
WEBAUTHN_ORIGIN=https://dev.example.com:3001
FRONTEND_URL=https://dev.example.com:3001
WEBAUTHN_RP_NAME=AK Portfolio (Dev)

# ── Logging (#153) ───────────────────────────────────────────────────────────
LOG_LEVEL=debug

# ── Email — Outlook OAuth2 (preferred) ───────────────────────────────────────
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REFRESH_TOKEN=
OUTLOOK_EMAIL=

# ── Email — SMTP fallback ────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Sole admin email — REQUIRED. Server-side enforced for setup and login.
ADMIN_EMAIL=you@example.com

# ── Error alerting (#333) ────────────────────────────────────────────────────
ERROR_ALERT_THRESHOLD=20
ERROR_ALERT_WINDOW_MS=900000

# ── Backend error webhook (#156) ─────────────────────────────────────────────
# Optional. When set, the backend POSTs a JSON payload to this URL whenever an
# unhandled 5xx error occurs. Works with Discord, Slack, or any JSON webhook.
# Leave blank to disable.
ERROR_WEBHOOK_URL=

# ── Offsite backups (optional — rclone) ──────────────────────────────────────
RCLONE_REMOTE=
RCLONE_BUCKET=

# Ollama (local AI — primary provider for Generate with AI on admin AI Dev Blog page)
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=tinyllama

# AI generation (optional — enables Generate with AI on admin AI Dev Blog page)
ANTHROPIC_API_KEY=
