# Production environment variables for Docker Compose.
# Copy to .env and fill in all required values before first deploy.
# Never commit .env to version control.

# ── Domain ────────────────────────────────────────────────────────────────────
# The public domain name (no https://, no trailing slash)
DOMAIN=andykeys.me

# ── Database ─────────────────────────────────────────────────────────────────
DB_NAME=portfolio_prod
DB_USER=postgres
DB_PASSWORD=replace_with_strong_password

# ── Backend ───────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production

# ── Deploy configuration (read by scripts/deploy/deploy.sh) ──────────────────
# Docker Compose service names — must match the services in the compose file.
NGINX_SERVICE=nginx
BACKEND_SERVICE=backend

# External port for nginx (prod uses 443; dev uses 3001).
NGINX_PORT=443

# Certificate source. Drives:
#   - whether self-signed certs are auto-generated pre-deploy (self-signed)
#   - whether DDNS sync is checked (letsencrypt)
#   - whether curl/puppeteer health checks pass --insecure
CERT_MODE=letsencrypt

# Branch to roll back to on deploy failure.
ROLLBACK_BRANCH=main

# Local directory where database/upload backups are written and checked (#164).
BACKUP_DIR=/home/ak/backups

# Structured logging level (#153): trace|debug|info|warn|error|fatal. Default info.
LOG_LEVEL=info

# Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_long_random_string
JWT_EXPIRY=7d

# ── WebAuthn (passkey auth) ───────────────────────────────────────────────────
# RP_ID is the domain only (no port, no protocol)
# ORIGIN is the full frontend URL as seen by the browser
WEBAUTHN_RP_ID=andykeys.me
WEBAUTHN_RP_NAME=AK Portfolio
WEBAUTHN_ORIGIN=https://andykeys.me

# ── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://andykeys.me

# ── Email (contact form + magic link login) ───────────────────────────────────
# OAuth2 is preferred. SMTP is used as fallback if OUTLOOK_* vars are absent.

# Outlook OAuth2 — run `node scripts/generate-outlook-refresh-token.js` once to obtain
OUTLOOK_CLIENT_ID=your_azure_app_client_id
OUTLOOK_CLIENT_SECRET=your_azure_app_client_secret
OUTLOOK_REFRESH_TOKEN=your_refresh_token_from_script
OUTLOOK_EMAIL=your_outlook_email@outlook.com

# SMTP fallback (Gmail with App Password, or custom SMTP relay)
# https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# The sole admin email address for this portfolio. REQUIRED.
# Server-side enforced: both initial passkey registration (POST /auth/setup)
# and magic-link login will ONLY work for this address. If unset, setup is
# refused entirely (fail closed) — the site cannot be registered.
ADMIN_EMAIL=your_email@outlook.com

# ── Offsite backups (optional — rclone) ───────────────────────────────────────
# Name of the rclone remote (run 'rclone config' to set up)
RCLONE_REMOTE=b2
# Backblaze B2 (or other) bucket name
RCLONE_BUCKET=portfolio-backups

# ── Disk encryption (NOT stored in .env — keep secure) ────────────────────────
# If server uses LUKS full-disk encryption with Dropbear SSH:
# - Disk encryption passphrase is NOT stored anywhere in the repo
# - Use it only when decrypting via Dropbear on server reboot:
#   ssh -p 2222 root@ak-home-server
#   cryptroot-unlock
#   (type passphrase when prompted)
# - Store the passphrase securely (password manager, not in code)
