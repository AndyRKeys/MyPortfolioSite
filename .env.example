# Production environment — public, HTTPS on 443, Let's Encrypt.
# Copy to ~/MyPortfolioSite/.env and fill in all values before first deploy.
# Never commit .env to version control.
#
# This template is kept structurally aligned with .env.dev-server.example so
# the two files diff cleanly. Same keys in the same order; only values differ.
#
# Disk-encryption passphrase is NOT stored in .env. Use it only via Dropbear
# SSH on server reboot (see docs/RUNBOOK.md → Server boot/decrypt).

# ── Network / hosting ─────────────────────────────────────────────────────────
LAN_IP=
DOMAIN=andykeys.me
SITE_HOST=andykeys.me

# ── Environment ──────────────────────────────────────────────────────────────
DEPLOY_ENV=prod

# ── Docker Compose ───────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=portfolio_prod
NGINX_SERVICE=nginx
BACKEND_SERVICE=backend
PORT=8080
NGINX_PORT=443
NGINX_HTTP_HOST_PORT=80
NGINX_CONF_TEMPLATE=./scripts/config/nginx-portfolio.conf.template
CERT_MOUNT_SRC=/etc/letsencrypt
CERT_MOUNT_DST=/etc/letsencrypt

# Optional volume name overrides to preserve existing data on first deploy.
# Leave empty for fresh project-namespaced volumes (recommended for new installs).
# To keep existing prod data: POSTGRES_VOLUME_NAME=postgres_data ; UPLOADS_VOLUME_NAME=uploads_data
POSTGRES_VOLUME_NAME=
UPLOADS_VOLUME_NAME=

# ── Deploy ───────────────────────────────────────────────────────────────────
CERT_MODE=letsencrypt
ROLLBACK_BRANCH=main
BACKUP_DIR=~/backups/prod

# ── Database ─────────────────────────────────────────────────────────────────
DB_NAME=portfolio_prod
DB_USER=postgres
DB_PASSWORD=replace_with_strong_password

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_long_random_string
JWT_EXPIRY=1h
# Internal service account key — used by regression tests to bypass contact
# rate limiting. Generate with: openssl rand -hex 32
# See: docs/SECURITY.md, issue #406
SERVICE_KEY=replace_with_long_random_string
# Service account JWT secret — used by automated services (deploy webhooks, scripts).
# Separate from JWT_SECRET so service credentials and admin credentials are non-interchangeable.
# Generate with: openssl rand -hex 32 (must be different from JWT_SECRET)
# See: scripts/ops/generate-service-token.js
SERVICE_JWT_SECRET=replace_with_long_random_string

# ── WebAuthn ─────────────────────────────────────────────────────────────────
WEBAUTHN_RP_ID=andykeys.me
WEBAUTHN_ORIGIN=https://andykeys.me
FRONTEND_URL=https://andykeys.me
WEBAUTHN_RP_NAME=AK Portfolio

# ── Logging (#153) ───────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Email — Outlook OAuth2 (preferred) ───────────────────────────────────────
OUTLOOK_CLIENT_ID=your_azure_app_client_id
OUTLOOK_CLIENT_SECRET=your_azure_app_client_secret
OUTLOOK_REFRESH_TOKEN=your_refresh_token_from_script
OUTLOOK_EMAIL=your_outlook_email@outlook.com

# ── Email — SMTP fallback ────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Sole admin email — REQUIRED. Server-side enforced for setup and login.
ADMIN_EMAIL=your_email@outlook.com

# ── Error alerting (#333) ────────────────────────────────────────────────────
# Send an email when this many frontend errors arrive within the window.
# Defaults: 20 errors in 15 minutes. Set to 0 to disable alerting.
ERROR_ALERT_THRESHOLD=20
ERROR_ALERT_WINDOW_MS=900000

# ── Offsite backups (optional — rclone) ──────────────────────────────────────
RCLONE_REMOTE=b2
RCLONE_BUCKET=portfolio-backups
