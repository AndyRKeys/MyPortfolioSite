# Backend environment variables — local development only.
# For Docker-based dev, use the root .env.example instead.
# For Ubuntu dev server, use .env.dev-server.example instead.

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portfolio_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# Server
PORT=3001
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRY=7d

# Email: choose ONE method below
# Method 1: Basic Auth (Gmail or custom SMTP)
# Gmail: use an App Password, not your account password
# https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Method 2: OAuth2 (Outlook — leave blank if using Basic Auth)
# Generate credentials: run `node scripts/generate-outlook-refresh-token.js` locally
# OUTLOOK_CLIENT_ID=your_azure_app_client_id
# OUTLOOK_CLIENT_SECRET=your_azure_app_client_secret
# OUTLOOK_REFRESH_TOKEN=your_refresh_token_from_script
# OUTLOOK_EMAIL=your_outlook_email@outlook.com

# The sole admin email address for this portfolio.
# Magic link login will ONLY work for this email address.
ADMIN_EMAIL=your_email@gmail.com

# WebAuthn — RP_ID is the domain only (no port), ORIGIN is the full frontend URL
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=AK Portfolio
WEBAUTHN_ORIGIN=http://localhost:3000

# Frontend URL for CORS and email magic links
FRONTEND_URL=http://localhost:3000
