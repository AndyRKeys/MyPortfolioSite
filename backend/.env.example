# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portfolio_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# Server
PORT=3001
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_string

# Email (Gmail example — use an App Password, not your account password)
# https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com

# WebAuthn — RP_ID is the domain only (no port), ORIGIN is the full frontend URL
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=AK Portfolio
WEBAUTHN_ORIGIN=http://localhost:3000

# Frontend URL for CORS and email magic links
FRONTEND_URL=http://localhost:3000
