# Docker Compose local development environment
# Copy this to .env in the root directory and adjust as needed.
# See root .env.example for the canonical reference.

# Backend
PORT=8080

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=portfolio_dev
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=dev-secret-key-change-in-production-min-32-chars
JWT_EXPIRY=7d

# WebAuthn
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=AK Portfolio
WEBAUTHN_ORIGIN=http://localhost
FRONTEND_URL=http://localhost

# Email: choose ONE method below
# Method 1: Basic Auth (Gmail or custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Method 2: OAuth2 (Outlook — leave blank if using Basic Auth)
# OUTLOOK_CLIENT_ID=
# OUTLOOK_CLIENT_SECRET=
# OUTLOOK_REFRESH_TOKEN=
# OUTLOOK_EMAIL=

# The sole admin email address for this portfolio.
# Magic link login will ONLY work for this email address.
ADMIN_EMAIL=
