# Docker Compose local development environment
# Copy this to .env in the root directory and adjust as needed

# Backend
PORT=8080

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=portfolio_dev
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=dev-secret-key-change-in-production-min-32-chars
JWT_EXPIRY=7d

# WebAuthn
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=AK Portfolio
WEBAUTHN_ORIGIN=http://localhost
FRONTEND_URL=http://localhost

# SMTP (optional, leave blank if not testing email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=
